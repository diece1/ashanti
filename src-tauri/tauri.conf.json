{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ashanti",
  "version": "0.1.0",
  "identifier": "com.ashanti.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Forêt des Ancêtres — Les âmes de Loïc",
        "width": 960,
        "height": 544,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCRDg4QzI5OTg0RDhFQTYKUldTbWprMllLWXpZRzJkbVJ6cnNrbnQ2S1htMk9YQzJ6UStlTzFuT3hUWFlhM1U5R0Y0UHdkZHIK",
      "endpoints": [
        "https://github.com/diece1/ashanti/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}